# ============================================================
# SM-WEB — contoh environment (salin ke .env, isi sesuai target)
# Panduan lengkap: README.md — §3 Deploy Vercel + Supabase
# ============================================================

# ---------- PRODUKSI: Vercel + Supabase PostgreSQL (keputusan D-5:
#            project Supabase BARU khusus SM-WEB, TERPISAH dari IC) ----------
# Ambil dari Dashboard Supabase → Project Settings → Database:
#   DATABASE_URL → Connection String tab "Session pooler"  (port 5432)
#                  → dipakai aplikasi saat runtime.
#   DIRECT_URL   → Connection String tab "Direct connection"
#                  → dipakai Prisma untuk DDL (`bun run db:push:supabase`).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ---------- ENGINE SERVICE (opsional) ----------
# Default http://127.0.0.1:3030 (demo) & :3031 (produksi) — hanya relevan bila
# engine di-host di mesin yang sama (self-host / sandbox).
# Di Vercel service lokal tidak ada: run DEMO otomatis memakai fallback
# EMBEDDED (generator identik, deterministik). Isi nilai di bawah hanya bila
# engine di-host terpisah (Railway/Fly/VPS — lihat README §5).
#SM_ENGINE_URL=http://127.0.0.1:3030
#SM_ENGINE_PROD_URL=http://127.0.0.1:3031
# Matikan fallback embedded (hanya terima hasil engine service):
#SM_ENGINE_EMBED_FALLBACK=off

# ---------- DEV LOKAL TANPA POSTGRES: SQLite (cermin schema.sqlite.prisma) ----------
# Path file: relatif terhadap DIREKTORI SKEMA (prisma/) — "../db/custom.db"
# menunjuk ke <root>/db/custom.db. Jalankan `bun run db:push` (otomatis
# menurunkan prisma/schema.sqlite.prisma dari kanonik PostgreSQL).
#DATABASE_URL=file:../db/custom.db
#DIRECT_URL=
